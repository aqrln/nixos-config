+(defvar agent-shell-markdown-image-display-p-functions nil
+  "Functions that report support for images outside graphical frames.
+Each function is called without arguments.  A non-nil return enables
+image properties; the backend is responsible for displaying them.")
+
+(defvar agent-shell-markdown-image-update-functions nil
+  "Functions called with START, END and IMAGE after an image is installed.
+IMAGE is the native image specification stored in the `display' property.
+Backends can mirror that property without changing Markdown parsing.")
+
+(defun agent-shell-markdown--image-display-p ()
+  "Return non-nil when native or external image display is available."
+  (or (display-graphic-p)
+      (run-hook-with-args-until-success
+       'agent-shell-markdown-image-display-p-functions)))
+
+(defun agent-shell-markdown--put-image (start end image)
+  "Install IMAGE on START through END and notify display backends."
+  (when (display-graphic-p)
+    (image-flush image))
+  (add-text-properties start end
+                       (list 'display image 'agent-shell-markdown-image t))
+  (run-hook-with-args 'agent-shell-markdown-image-update-functions
+                      start end image))
+
+(defun agent-shell-markdown--window-pixels (window dimension)
+  "Return WINDOW's body size in pixels along DIMENSION."
+  (if (eq dimension 'width)
+      (window-body-width window t)
+    (window-body-height window t)))
+
